<?xml version="1.0"?>
<package format="2">
  <name>vitfly_planner_bridge</name>
  <version>0.1.0</version>
  <description>ROS bridge between ViTFly Flightmare topics and external planners.</description>
  <maintainer email="vitfly@example.com">ViTFly</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <exec_depend>python3-numpy</exec_depend>
</package>
